# .htaccess (raiz do projeto)
#
# Esta regra é redundante com o bloqueio equivalente em
# .nixpacks/assets/nginx.template.conf (usado no deploy via Railway), mas
# .htaccess só é lido por servidores Apache — então isto é o que protege
# o projeto caso ele seja hospedado em algum host baseado em Apache
# (ex.: hospedagem compartilhada), onde o nginx.template.conf não se
# aplica.

# Nunca liste o conteúdo de uma pasta que não tenha index
Options -Indexes

# Bloqueia download direto de dumps de banco, backups, configs, etc.
<FilesMatch "\.(sql|zip|tar|tar\.gz|gz|rar|7z|bak|old|log|md|env|txt|ini|conf|yml|yaml)$">
    Require all denied
</FilesMatch>

# Bloqueia qualquer arquivo oculto (.git, .env, .htpasswd, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Pastas que não devem ser acessadas via navegador de jeito nenhum
RedirectMatch 404 ^/scriptBD/
RedirectMatch 404 ^/\.nixpacks/
RedirectMatch 404 ^/includes/.*\.php$

# Agendamento público por link (sem login) — ver Publico/paginas/agendar.php
# e includes/PublicoTokenService.php. URL bonita e "inquebrável" (o token
# de verdade que identifica o barbeiro é aleatório, não o que aparece na
# URL): /c/agendar/<slug-token> -> Publico/paginas/agendar.php?t=<slug-token>
# Regra equivalente para deploy via Railway/nginx em
# .nixpacks/assets/nginx.template.conf.
#
# A flag E=VIA_LINK_PUBLICO:1 marca a requisição como tendo passado por
# aqui; a regra logo abaixo usa essa marca pra bloquear quem tentar acessar
# Publico/paginas/agendar.php diretamente pela URL "feia" (só a URL bonita
# funciona). Os endpoints em Publico/scripts/*.php NÃO são afetados — eles
# continuam acessíveis diretamente, pois são chamados pelo JS do navegador.
RewriteEngine On
RewriteRule ^c/agendar/([a-z0-9-]+)/?$ Publico/paginas/agendar.php?t=$1 [L,QSA,E=VIA_LINK_PUBLICO:1]

# Link GERAL da barbearia (sem token) — ver Publico/paginas/escolher_barbeiro.php.
# Lista os barbeiros pra escolher; cada um continua tendo seu link pessoal
# (regra acima), sem depender desta lista.
RewriteRule ^c/agendar/?$ Publico/paginas/escolher_barbeiro.php [L,QSA,E=VIA_LINK_PUBLICO:1]

RewriteCond %{REQUEST_URI} ^/Publico/paginas/agendar\.php$
RewriteCond %{ENV:REDIRECT_VIA_LINK_PUBLICO} !^1$
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_URI} ^/Publico/paginas/escolher_barbeiro\.php$
RewriteCond %{ENV:REDIRECT_VIA_LINK_PUBLICO} !^1$
RewriteRule ^ - [F,L]

# URLs curtas das páginas de gestão (login já exigido nelas mesmas — ver
# includes/guard.php) — piloto: Configurações. A URL "feia" continua
# funcionando também (sem bloqueio), diferente do link público acima; se
# no futuro quisermos bloquear o acesso direto aqui também, o padrão é o
# mesmo já usado para Publico/paginas/agendar.php.
RewriteRule ^configuracoes/?$ Configuracoes/paginas/configuracoes.php [L,QSA]
